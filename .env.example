# Copie para .env e use senhas próprias. Nunca versione .env.
POSTGRES_PASSWORD=replace_with_a_long_random_password
RABBITMQ_PASSWORD=replace_with_another_long_random_password
GATEWAY_PORT=8088
# Opcional: URL pública da interface Swagger da API desta farmácia.
# Vazio mantém o atalho desabilitado como "Swagger · Em breve".
# Após configurar, reconstrua o frontend: docker compose up -d --build web
NEXT_PUBLIC_SWAGGER_URL=
